{
  "version": "2.0",
  "envId": "{{env.ENV_ID}}",
  "framework": {
    "name": "hovai",
    "plugins": {
      "client": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "buildCommand": "npm run build",
          "outputPath": "public",
          "cloudPath": "/"
        }
      },
      "admin": {
        "use": "@cloudbase/framework-plugin-function",
        "inputs": {
          "functionRootPath": "cloudfunctions",
          "functions": [
            {
              "name": "api",
              "timeout": 60,
              "runtime": "Nodejs18.15",
              "installDependency": true,
              "handler": "index.main"
            }
          ]
        }
      }
    }
  }
}