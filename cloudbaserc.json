{
  "version": "2.0",
  "envId": "{{env.ENV_ID}}",
  "framework": {
    "name": "huohai-portfolio",
    "plugins": {
      "client": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "buildCommand": "npm run build",
          "outputPath": "dist/public",
          "cloudPath": "/"
        }
      },
      "api": {
        "use": "@cloudbase/framework-plugin-function",
        "inputs": {
          "functionRootPath": "dist/cloudfunctions",
          "functions": [
            {
              "name": "portfolio",
              "timeout": 30,
              "runtime": "Nodejs18.15",
              "installDependency": true,
              "handler": "index.main"
            }
          ]
        }
      }
    }
  }
}