# Only needed when you keep server-side content writes via a CloudBase cloud function.
# Public content is served from public/data/site.json, so the front-end does not need these.
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
# CloudBase environment id and (optional) static web app id.
CLOUD_ENV=your-env-id